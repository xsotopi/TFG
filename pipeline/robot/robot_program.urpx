l":"Status"},{"children":[{"children":[],"contributedNode":{"type":"ur-script","version":"0.0.1","parameters":{"name":"move_top_obj","expression":"\ndef move_from_pc():\n    if (not socket_open(\"192.168.0.104\", 50000, \"pose\")):\n        socket_close(\"pose\")\n        if (not socket_open(\"192.168.0.104\", 50000, \"pose\")):\n            popup(\"Pose socket cannot be opened\")\n            halt\n        end\n    end\n    \n    vals = socket_read_ascii_float(6, \"pose\", 0)\n    \n    #popup(vals)\n    \n    if (vals[0] == 6):\n        \n        x = vals[1] - 0.005\n        y = vals[2] - 0.005\n        z = vals[3]\n        Rx = vals[4]\n        Ry = vals[5]\n        Rz = vals[6]\n    \n        movel(p[x,y,z,Rx,Ry,Rz], a=0.1, v=0.1)\n    else:\n        textmsg(\"Pose read failed or timed/out\")\n    end\n    \nend\n\nmove_from_pc()","valid":true},"isSuppressed":false},"guid":"b45d6594-656c-00e7-de1f-ae1e5251a6cb","parentId":"0b76e6d5-9218-38ee-d2d7-2a2cdb0919f1","programLabel":"move_top_obj"},{"children":[],"contributedNode":{"type":"ur-direction","version":"1.1.0","lockChildren":false,"allowsChildren":false,"parameters":{"name":{"entity":{"name":"approach_obj","reference":false,"type":"$$Variable","valueType":"string","declaredByID":"15d485c5-3b5e-e00b-54a1-11601c387bb1"},"selectedType":"VALUE","value":"approach_obj"},"frame":{"name":"base","nameVariable":{"name":"base","reference":false,"type":"$$Variable","valueType":"frame","declaredByID":"15d485c5-3b5e-e00b-54a1-11601c387bb1"},"parent":"world","pose":{"position":[0,0,0],"orientation":[0,0,0]}},"axis":"Z-","advanced":{"movement":{"speed":{"entity":{"value":0.1,"unit":"m/s"},"selectedType":"VALUE","value":0.1},"acceleration":{"entity":{"value":0.5,"unit":"m/s^2"},"selectedType":"VALUE","value":0.5}},"reference":{},"until":{"conditions":[{"index":-1,"type":"distance","parameters":{"distance":{"entity":{"value":0.055,"unit":"m"},"selectedType":"VALUE","value":0.055}}}]}}}},"guid":"15d485c5-3b5e-e00b-54a1-11601c38